{
  "name": "subagents",
  "private": true,
  "type": "module",
  "scripts": {
    "link-host-deps": "node link-host-deps.mjs",
    "check": "npm run link-host-deps --silent && tsc --noEmit -p .",
    "prepare": "effect-tsgo patch",
    "test": "npm run link-host-deps --silent && node --test --experimental-strip-types manager.test.ts result-delivery.test.ts context-usage.test.ts takeover.test.ts policy.test.ts",
    "test:live": "npm run link-host-deps --silent && node --test --experimental-strip-types codex.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "effect": "4.0.0-beta.98"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.19.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
